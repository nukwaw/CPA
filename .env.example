# Example environment configuration for CLIProxyAPI.
# Copy to .env only if it does not already exist; uncomment only options you need.
# Native runs load .env from the working directory. Compose interpolates it but
# passes only explicitly mapped variables; it does not automatically inject .env.
# Local file-based storage needs no environment variables or database password.

# ------------------------------------------------------------------------------
# Management Web UI and statistics API (optional)
# ------------------------------------------------------------------------------
# A config management.secret-key is an alternative to this environment setting.
# SECURITY: nonempty MANAGEMENT_PASSWORD also permits remote management even if
# management.allow-remote is false. Restrict access and use HTTPS.
# MANAGEMENT_PASSWORD=change-me-to-a-strong-password

# ------------------------------------------------------------------------------
# Existing deployment/image selection (base docker-compose.yml is unchanged)
# ------------------------------------------------------------------------------
# CLI_PROXY_IMAGE=eceasy/cli-proxy-api:latest
# CLI_PROXY_CONFIG_PATH=./config.yaml
# CLI_PROXY_AUTH_PATH=./auths
# CLI_PROXY_LOG_PATH=./logs
# CLI_PROXY_PLUGIN_PATH=./plugins
# To build this fork, explicitly choose a LOCAL image tag and run compose build.
# See docs/usage-persistence.md; a regular up retains the chosen image/pull behavior.

# ------------------------------------------------------------------------------
# PostgreSQL AUTH/CONFIG store (optional; also reused by usage persistence)
# ------------------------------------------------------------------------------
# Enabling PGSTORE changes auth/config storage, not just usage storage. Back up and
# plan migration first. PGSTORE loads config from DB/spool and bootstraps from the
# working directory's config.example.yaml, NOT the normal config.yaml argument.
# Never point the spool at existing auth files: bootstrap rebuilds spool auths.
# Native pgstore_dsn, pgstore_schema, pgstore_local_path forms also remain valid.
# PGSTORE_DSN=postgresql://user:URL_ENCODED_PASSWORD@db.example:5432/cliproxy?sslmode=verify-full
# PGSTORE_SCHEMA=public
# Parent of the pgstore/ spool; use an absolute container path in bundled Compose.
# PGSTORE_LOCAL_PATH=/var/lib/cliproxy

# ------------------------------------------------------------------------------
# Opt-in bundled PostgreSQL: docker compose -f docker-compose.postgres.yml ...
# ------------------------------------------------------------------------------
# These POSTGRES_* values are only required/read by that separate deployment.
# They are NOT required by base Compose, native local runs, Home, or external DBs.
# Generate a password with: openssl rand -hex 32
# Use URL-safe user/password/database values: the bundled file constructs PGSTORE_DSN
# for its postgres service. It does not use an external shell PGSTORE_DSN override.
# POSTGRES_PASSWORD=
# POSTGRES_USER=cliproxy
# POSTGRES_DB=cliproxy
# The selected config is mounted read-only at config.example.yaml as an initial
# seed. After bootstrap the DB config is authoritative; editing the seed is not
# a config update. The postgres-data and postgres-spool named volumes are retained.

# ------------------------------------------------------------------------------
# Local usage state (no separate usage DSN/path or enable switch)
# ------------------------------------------------------------------------------
# With an active PostgresStore, usage borrows its existing SQL pool and schema.
# Otherwise the journal is <root>/usage/<hash-of-absolute-config-path>/usage.jsonl.
# Root is existing WRITABLE_PATH (or writable_path), otherwise resolved AuthDir.
# The config path identifies the instance, not a writable root. Persist the root.
# WRITABLE_PATH=/var/lib/cliproxy
# New collection uses ONLY the existing configuration option (default false):
#   v8: observability.usage.usage-statistics-enabled: true
#   v0: usage-statistics-enabled: true
# Disabling collection does not remove saved history/prices/quota.

# ------------------------------------------------------------------------------
# Git-Backed Config Store (optional)
# ------------------------------------------------------------------------------
# GITSTORE_GIT_URL=https://github.com/your-org/cli-proxy-config.git
# GITSTORE_GIT_USERNAME=git-user
# GITSTORE_GIT_TOKEN=ghp_your_personal_access_token
# GITSTORE_LOCAL_PATH=/data/cliproxy/gitstore

# ------------------------------------------------------------------------------
# Object Store Token Store (optional)
# ------------------------------------------------------------------------------
# OBJECTSTORE_ENDPOINT=https://s3.your-cloud.example.com
# OBJECTSTORE_BUCKET=cli-proxy-config
# OBJECTSTORE_ACCESS_KEY=your_access_key
# OBJECTSTORE_SECRET_KEY=your_secret_key
# OBJECTSTORE_LOCAL_PATH=/data/cliproxy/objectstore
